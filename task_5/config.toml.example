# GitLab Runner Configuration Example
# Place this file at: /etc/gitlab-runner/config.toml

concurrent = 4
check_interval = 0
log_level = "info"
log_format = "json"

[[runners]]
  name = "k8s-runner-worker1"
  url = "http://gitlab.test.local"
  id = 1
  token = "RUNNER_TOKEN_HERE"
  token_expiration_interval = 3600
  tls-ca-file = ""
  tls-cert-file = ""
  tls-key-file = ""
  tls-skip-verify = false
  
  [runners.machine]
    IdleCount = 0
    IdleTime = 600
    MaxBuilds = 100
    MachineDriver = ""
    MachineName = "gitlab-runner-%s"
    MachineOptions = []
  
  [runners.cache]
    Type = "s3"
    Path = "cache"
    Shared = false
    
    [runners.cache.s3]
      ServerAddress = "minio.gitlab.test.local:9000"
      AccessKey = "minioadmin"
      SecretKey = "minioadmin"
      BucketName = "runner-cache"
      BucketLocation = "us-east-1"
      Insecure = true
      UsePathStyle = true

  [[runners.docker]]
    host = "unix:///var/run/docker.sock"
    privileged = false
    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    disable_cache = false
    volumes = ["/cache"]
    shm_size = 0
    dns = []
    dns_search = []
    pull_policy = ["if-not-present"]
    security_opt = []
    userns_mode = ""
    runtime = ""
    cpus = ""
    memory = ""
    memory_swap = ""
    memory_reservation = ""
    oom_score_adjust = ""
    cpu_shares = 1024
    cpuset_cpus = ""
    cpuset_mems = ""
    pids_limit = 0

# Alternative: Shell Executor Configuration
